# ============================================================================
# Smart Billing Agent — configuração local
# ----------------------------------------------------------------------------
# Copie este arquivo para ".env" (o install-agent.bat faz isso automaticamente
# se ".env" ainda não existir) e preencha os valores abaixo. NUNCA versione o
# arquivo ".env" real — ele fica no .gitignore de propósito.
# ============================================================================

# URL do seu projeto Supabase (Project Settings → API → Project URL)
SUPABASE_URL=

# URL completa da Edge Function whatsapp-agent-api, por exemplo:
# https://SEU-PROJETO.supabase.co/functions/v1/whatsapp-agent-api
WHATSAPP_AGENT_FUNCTION_URL=

# Segredo compartilhado com a Edge Function (o MESMO valor deve estar
# cadastrado em supabase secrets set WHATSAPP_AGENT_TOKEN=...). Gere um
# valor longo e aleatório — veja o README para um comando pronto.
WHATSAPP_AGENT_TOKEN=

# ID (UUID) da empresa no Smart Billing para a qual este agente envia
# mensagens. Encontre em Configurações → Empresa, ou consultando a tabela
# "companies" no Supabase.
COMPANY_ID=

# URL pública onde o Smart Billing está hospedado (usada só para exibir nos
# logs locais — os links enviados nas mensagens já vêm prontos do banco).
PUBLIC_APP_URL=https://limaribeiroabraaolimaribeiro-afk.github.io/Smart-Billingg

# Intervalo (ms) entre consultas à fila de mensagens (envio de WhatsApp).
POLL_INTERVAL_MS=5000

# Intervalo (minutos) entre ciclos do scheduler de cobrança automática
# (identifica cobranças a vencer/vencidas e dispara WhatsApp/e-mail).
# Lembretes são por dia, não por minuto — não configure um valor agressivo.
# Mínimo aplicado internamente: 5. Padrão: 30.
WORKER_INTERVAL_MINUTES=30

# Timezone usada em todos os cálculos de vencimento/cobrança. O Smart Billing
# assume clientes no Brasil — não altere, a menos que saiba o que está
# fazendo. Importante sobretudo na VPS, que normalmente roda em UTC.
TIMEZONE=America/Sao_Paulo

# Porta do servidor local de diagnóstico/controle (http://127.0.0.1:PORT).
PORT=3210

# ----------------------------------------------------------------------------
# O que NÃO entra aqui (de propósito):
#   - SUPABASE_SERVICE_ROLE_KEY — o worker nunca fala direto com o Postgres;
#     toda leitura/escrita passa pela Edge Function whatsapp-agent-api
#     (autenticada por WHATSAPP_AGENT_TOKEN acima), que já roda com
#     service_role do lado do Supabase. Ver ETAPA "SUPABASE SERVICE ROLE".
#   - RESEND_API_KEY / e-mail — o worker também não guarda a chave do Resend;
#     o envio de e-mail de lembrete acontece dentro da própria Edge Function
#     (ação send_email_reminder), usando os MESMOS secrets já configurados
#     para send-receipt-email (RESEND_API_KEY, EMAIL_FROM, PUBLIC_APP_URL —
#     configurados via "supabase secrets set", nunca num .env de VPS).
# ----------------------------------------------------------------------------
